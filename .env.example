# --- Supabase ---
# Found in Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key is ONLY used in server actions that must bypass RLS
# (e.g. creating the very first admin user). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Initial admin bootstrap (used once by scripts/create-admin, see README) ---
INITIAL_ADMIN_EMAIL=artee.ravinash@com
INITIAL_ADMIN_PASSWORD=artee@ravinash
